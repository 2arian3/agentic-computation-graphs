# Python
.venv/
__pycache__/
*.pyc

# local pip/temp caches (kept off the small root disk)
.tmp/
.pipcache/

# model weights cache (large; re-downloadable)
hf-cache/

# generated outputs — keep the dirs, drop the artifacts
traces/*.jsonl
traces/*.csv
traces/*.json
# ...but DO keep the small run-level provenance sidecars (reproducibility record).
!traces/*provenance.json
traces/_*.log
traces/figures/*.png
traces/figures/*.html
# per-run traces written by the web dashboard
traces/webapp/

# local env
.env
