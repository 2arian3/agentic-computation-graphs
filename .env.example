# Copy to .env and `set -a; source .env; set +a` before running, or export directly.
# These are the knobs that must be held CONSTANT for a clean variance study.

# ---- serving endpoint (local vLLM/SGLang, never a closed product) ----
ACG_BASE_URL=http://localhost:8000/v1
ACG_API_KEY=EMPTY
ACG_SERVED_MODEL_NAME=qwen2.5-7b-instruct
ACG_GENAI_SYSTEM=qwen

# ---- decode parameters (pinned) ----
ACG_TEMPERATURE=0.7        # 0.0 for determinism checks; >0 for the variance study
ACG_TOP_P=0.95
ACG_MAX_TOKENS=1024
ACG_REQUEST_SEED=1234      # per-request seed; vary across reps for sampling variance

# ---- agent loop ----
ACG_MAX_STEPS=8
ACG_SEARCH_TOP_K=3

# ---- model serving (used by docker/serve_vllm.sh) ----
ACG_MODEL=Qwen/Qwen2.5-7B-Instruct
ACG_MAX_MODEL_LEN=8192
ACG_GPU_MEM_UTIL=0.85      # MIG 1g.24gb reports ~20.9/23.8 GiB free at startup
ACG_TOOL_PARSER=hermes     # hermes for Qwen2.5; llama3_json for Llama-3.x
ACG_ENGINE_SEED=1234
# ACG_GPU_DEVICE=MIG-xxxxxxxx-...   # pin a specific MIG slice; auto-detected if unset
